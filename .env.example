# Stack-wide docker compose configuration for docker-compose.all-services.yml.
#
# Copy to .env before deploying — docker compose reads .env, not .env.example:
#   cp .env.example .env
#
# Per-app settings live in each app's own .env.example; this file holds only the
# values the compose stack itself interpolates.

# Public HTTP entry point (nginx)
ORWELL_HTTP_PORT=8080

# The frame viewer's own port (apps/jarvis/frame-viewer). It is NOT behind nginx and is published to
# 127.0.0.1 only, because it browses recorded footage and can accept uploaded video with no
# authentication in front of either. This changes the host port, not the binding.
ORWELL_FRAME_VIEWER_PORT=9003

# Fixture detection (apps/jarvis/fixture-detection): lamp/stove/furnace on-off. Also not behind
# nginx and published to 127.0.0.1 only — /health and /fixtures carry no imagery, but the calibration
# preview returns a frame of your house and it is on the same port.
ORWELL_FIXTURE_DETECTION_PORT=9004
# Your fixture definitions. The app's directory is mounted read-only at /app/config, so:
#   cp apps/jarvis/fixture-detection/fixtures.{example.,}json   # then edit it
#   ORWELL_FIXTURE_DEFINITIONS_FILE=/app/config/fixtures.json
# Unset, the detector runs and watches nothing (and says so at startup) — shipped thresholds would be
# somebody else's lamp. See that app's README for how to calibrate rather than guess.
ORWELL_FIXTURE_DEFINITIONS_FILE=
# Set to http://alerting/alerts to have fixture transitions delivered as well as logged.
ORWELL_FIXTURE_ALERT_URL=

# The health monitor (apps/health-monitor): polls every service's /health and alerts on transitions.
# Its target list is set in docker-compose.all-services.yml, taken from nginx/all-services.conf.
# Not behind nginx and published to 127.0.0.1 only: /targets is a map of the internal topology.
ORWELL_HEALTH_MONITOR_PORT=9005
# Where health transitions are sent so they become EMAILS. Defaults to the alerting service, which is
# what turns an alert into mail — but only once ALERT_EMAIL_ENABLED=true, ALERT_EMAIL_TO=<you> and the
# SMTP_* settings are filled in on THAT service (apps/alerting/.env). Until then alerting accepts the
# alert and sends nothing, and health-monitor warns that it did.
#
# Set this to empty for logging only. Worth doing if you run a partial stack: a service you never
# started looks exactly like one that went down.
ORWELL_HEALTH_ALERT_URL=http://alerting/alerts

# Loki. Every server pushes its own app logs directly (packages/logger, LokiLogger) — there is
# no collector, so this value is handed to every Java service.
#
# LOKI_URL is the FULL push endpoint, including /loki/api/v1/push. It must point at the same
# Loki that apps/log-analyzer queries through Grafana (GRAFANA_LOKI_DATASOURCE_UID in
# apps/log-analyzer/.env.example) — if the two disagree, the analyzer queries an instance
# nothing writes to and silently reports no errors forever. Nothing checks this for you.
#
# Leave LOKI_URL empty to keep logs on the console only; services log a warning at startup so
# that choice is visible rather than silent. Credentials, if needed, belong in the URL
# (https://user:pass@host/...). LOKI_TENANT_ID sets X-Scope-OrgID for multi-tenant Loki.
LOKI_URL=http://loki:3100/loki/api/v1/push
LOKI_TENANT_ID=

# LOGGER picks the sinks behind every service's Logger. The console is in all of them — stdout is
# what docker logs reads — so this chooses what happens on top of it:
#
#   console             console only
#   disk                plus <log dir>/<app>.jsonl, one JSON object per line
#   loki                plus a direct push to Loki
#   loki-with-fallback  loki, with the disk file catching ONLY what Loki refused, so an outage
#                       costs a file instead of the records themselves
#   both                loki and disk, every record to each
#
# Leave it empty for the historical behavior: loki when LOKI_URL is set, console when it is not.
# A value that is not on the list fails startup rather than quietly becoming the default.
#
# One caveat for the compose stack: the file sinks write inside the container, where nothing is
# mounted, so a disk/fallback file dies with the container unless you add a volume. LOGGING_FILE_NAME
# moves the directory. LOGGER is passed to every Java service in docker-compose.all-services.yml.
LOGGER=

# ---------------------------------------------------------------------------------------------
# MinIO -> remote S3 backup (the `minio-backup` service in docker-compose.all-services.yml)
#
# Off unless the `backup` profile is selected, so leaving this section untouched changes nothing:
#   COMPOSE_PROFILES=backup ./scripts/stack.sh up -d
#
# The service mirrors one MinIO bucket to a remote S3-compatible bucket every
# MINIO_BACKUP_INTERVAL_SECONDS. It reads over the S3 API, not off the all-services-minio-data
# volume — see the comment above the service for why that distinction matters on restore.
#
# THE DESTINATION BUCKET NEEDS TWO SETTINGS, and without them this is replication, not backup.
# Mirroring reproduces the source, so corruption or an accidental delete reaches the copy on the
# next run; what buys back the ability to go to yesterday is the bucket, not this container:
#
#   1. Versioning ON, so an overwritten object keeps its previous version. Pair it with a
#      lifecycle rule expiring noncurrent versions after your retention window, or versioning
#      becomes the storage bill.
#   2. Object lock ON, in compliance mode. Governance mode can be overridden by a privileged
#      user, which on a compromised host is exactly the user you are defending against.
#
# CREDENTIALS. The source pair should be a read-only MinIO service account, not the root user
# (`mc admin user svcacct add`) — a backup job has no reason to be able to write to the store it
# is backing up. The destination pair cannot be write-only, which surprises people: `mc mirror` is
# incremental and needs ListBucket and GetObject on the destination to work out what is already
# there. Grant ListBucket + GetObject + PutObject and explicitly deny DeleteObject and
# DeleteObjectVersion. Object lock above is then what stops a compromised host destroying history.
#
# Real credentials do not belong in a committed file — put them in the gitignored .env.
MINIO_BACKUP_SOURCE_BUCKET=keeboarder-recordings
MINIO_BACKUP_SOURCE_KEY=minioadmin
MINIO_BACKUP_SOURCE_SECRET=minioadmin

# Full URL including scheme, e.g. https://s3.us-east-1.amazonaws.com. Any S3-compatible endpoint
# works. Worth weighing when picking one: egress pricing is what a restore actually costs, and it
# varies by two orders of magnitude between providers.
MINIO_BACKUP_REMOTE_ENDPOINT=
MINIO_BACKUP_REMOTE_BUCKET=
# Optional path inside that bucket, e.g. orwell/recordings. Empty puts objects at its root.
MINIO_BACKUP_REMOTE_PREFIX=
MINIO_BACKUP_REMOTE_KEY=
MINIO_BACKUP_REMOTE_SECRET=

# Seconds between mirror passes. 86400 is daily.
MINIO_BACKUP_INTERVAL_SECONDS=86400
