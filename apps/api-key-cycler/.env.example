# API key cycler configuration
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9310

# The one upstream every request goes to. Point it at the API whose keys are being cycled, or at
# the reverse proxy on 9300 to have the rotated requests land in request_audit as well.
CYCLER_UPSTREAM_URL=https://api.example.com
CYCLER_UPSTREAM_TIMEOUT_SECONDS=30
CYCLER_MAX_BODY_BYTES=10485760

# The pool, comma-separated. These are secrets: this file is an example and the values here are
# not real, but a deployment should not put live keys in a .env or a compose file either. Launch
# the jar with the `url` argument instead and the whole environment — this key included — is
# fetched from the secrets manager at startup. See dev.orwell.env.http.EnvLoader.
CYCLER_API_KEYS=first-example-key,second-example-key,third-example-key

# How the key is written onto the request. `Authorization` + `Bearer` produces
# `Authorization: Bearer <key>`; an empty scheme produces a bare value, which is what an
# `X-API-Key` style header wants. Whatever the client sent under this header is replaced.
CYCLER_KEY_HEADER=Authorization
CYCLER_KEY_SCHEME=Bearer

# Which answers mean "this key is spent for now". 429 is the rate limit; 401 and 403 are here
# because a revoked or suspended key answers with those and is just as unusable. Leave empty to
# spread requests round-robin and never react to what comes back.
CYCLER_ROTATE_ON_STATUSES=429,401,403

# How long a refused key rests before it is offered again. Longer than the upstream's rate-limit
# window idles capacity; much shorter turns the pool back into a queue on the first key.
CYCLER_COOLDOWN_SECONDS=60

# Upstream trips one client request may cost. Capped at the number of keys at startup — trying
# more times than there are keys can only repeat one that already refused.
CYCLER_MAX_ATTEMPTS=3
