# Alerting service configuration.
#
# This is the repo's ONE mail sender: every alert anything raises — apps/health-monitor,
# jarvis-person-detection, jarvis-fixture-detection, apps/liveness-analyzer, apps/log-analyzer —
# arrives here as POST /alerts and becomes an email from here or from nowhere.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9000

# --- Email -------------------------------------------------------------------------------------
# THREE THINGS DECIDE WHETHER MAIL LEAVES: enabled, a recipient, and a reachable SMTP host. With any
# of them missing this service still answers 200 to every alert and silently sends nothing — that is
# deliberate (an alert is recorded whether or not it can be mailed) but it means "no error" is not
# evidence of delivery. apps/health-monitor reads the response and reports emailsSentTotal separately
# from alertsSentTotal for exactly this reason.
ALERT_EMAIL_ENABLED=false
# Where every alert goes. There is no per-alert recipient, on purpose: POST /alerts is proxied by
# nginx on 0.0.0.0:8080, so a recipient in the request body would make this an open relay. Alerts
# that need a different address get a second deployment of this service.
ALERT_EMAIL_TO=
# Blank falls back to ALERT_EMAIL_TO.
ALERT_EMAIL_FROM=

# --- SMTP --------------------------------------------------------------------------------------
# NOTE this service speaks STARTTLS only: SMTP_USE_TLS sets mail.smtp.starttls.enable, so use the
# submission port (587), not implicit TLS on 465. A provider that only offers 465 needs a code
# change in SmtpConfig, not a config change here.
#
# Sending to a Gmail address? The simplest working setup is Gmail's own SMTP — no mail server to run,
# no deliverability to earn, because the recipient is the same account:
#
#   ALERT_EMAIL_TO=you@gmail.com
#   ALERT_EMAIL_FROM=you@gmail.com      # must be the account or a verified alias, or Gmail rewrites it
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_USE_TLS=true
#
# The app password needs 2-step verification enabled on the account first; the account password will
# not authenticate. Real credentials belong in the gitignored .env beside this file, never here.
#
# Testing locally? Point this at a mail catcher instead and nothing leaves the machine:
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_USE_TLS=false  (and no username/password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# The alert trail: every alert received, whether or not it was mailed. Its own JSON-lines sink,
# separate from the app-wide logger.
ALERT_LOG_FILE=/var/log/streaming/alerts.log
SERVER_ENGINE=spring
