BACKUP_OUTPUT_DIR=backups
# Dumps older than this are deleted, in BACKUP_OUTPUT_DIR *and* in every per-project
# BACKUP_<NAME>_STORAGE_DIR below. 0 keeps everything.
BACKUP_RETENTION_DAYS=30

BACKUP_PROJECTS=klippy,auth,secrets

BACKUP_KLIPPY_DATABASE_URL=postgresql://klippy:klippy@localhost:5432/klippy
BACKUP_KLIPPY_STORAGE_TYPE=directory

BACKUP_AUTH_DATABASE_URL=postgresql://auth:auth@localhost:5432/auth
BACKUP_AUTH_STORAGE_TYPE=directory

BACKUP_SECRETS_DATABASE_URL=postgresql://secrets:secrets@localhost:5432/secrets
BACKUP_SECRETS_STORAGE_TYPE=directory

# Optional per project: store that project's dumps somewhere other than BACKUP_OUTPUT_DIR. It may be
# a separate mount — the dump is written under BACKUP_OUTPUT_DIR first and moved here, falling back
# to copy-and-delete when the two are on different filesystems.
# BACKUP_SECRETS_STORAGE_DIR=/mnt/backups/secrets
