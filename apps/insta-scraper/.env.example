# insta-scraper — the service behind insta's `self-hosted` connections source.
#
# Copy to .env. INSTA_SCRAPER_SESSIONID is the only required value; without it the
# process refuses to start, deliberately — a scraper with no session that looks healthy
# would make insta pay a paid actor for every walk and the bill would be the only symptom.

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8099

# ─── who may call this ────────────────────────────────────────────────────────
# Must match INSTA_SELFHOSTED_TOKEN on insta's side. Blank disables the check,
# which is only sane while bound to 127.0.0.1 — this endpoint hands out follower
# graphs to anything that can reach the port.
# INSTA_SCRAPER_TOKEN=

# ─── the Instagram session ────────────────────────────────────────────────────
# From a logged-in browser: DevTools → Application → Cookies → instagram.com.
# sessionid alone IS the login — whoever holds it is signed in as that account
# until it is revoked. Use a burner, not your main.
INSTA_SCRAPER_SESSIONID=
INSTA_SCRAPER_DS_USER_ID=
INSTA_SCRAPER_CSRF_TOKEN=
# Anything else from the same jar, as `name=value; name=value`. These are device
# identity — keep them stable, a session whose device changes every call is the
# pattern fraud detection looks for.
# INSTA_SCRAPER_EXTRA_COOKIES=mid=...; ig_did=...

# Must match the browser the cookies came from.
# INSTA_SCRAPER_USER_AGENT=
# The public web app id. Without it the endpoints answer 400.
# INSTA_SCRAPER_APP_ID=936619743392459

# ─── rate limiting ────────────────────────────────────────────────────────────
# The two halves of the budget. The interval spaces requests out; the hourly cap
# bounds how many there can be however patiently they are spaced. An interval
# alone will happily make 1,800 requests an hour and get the account flagged.
# Both defaults are conservative. Raise them and you are spending the account.
# INSTA_SCRAPER_MIN_INTERVAL_MILLIS=2000
# INSTA_SCRAPER_HOURLY_REQUESTS=200
# INSTA_SCRAPER_PAGE_SIZE=50

# How long one /connections call may spend collecting pages before returning what
# it has with a cursor. Keep under insta's INSTA_HTTP_TIMEOUT_SECONDS (60).
# INSTA_SCRAPER_MAX_SECONDS_PER_REQUEST=40

# ─── logging ──────────────────────────────────────────────────────────────────
# LOGGER=console
# LOKI_URL=
# LOKI_TENANT_ID=
