# Jarvis Detection configuration
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9001
DETECTION_ALERT_URL=http://127.0.0.1:9000/alerts
DETECTION_ALERT_COOLDOWN_SECONDS=60
DETECTION_MIN_CONFIDENCE=0.0
# Frame-to-frame change detection (POST /motion, and the gate for DETECTION_RELAY_MODE=changed)
DETECTION_MOTION_CELL_THRESHOLD=12
DETECTION_MOTION_MIN_CHANGED_FRACTION=0.02

# Frame hub (POST /frames -> GET /frames/stream). Frames are stored so a client that reconnects
# can be replayed what it missed, so the datasource is REQUIRED. Role and database come from
# db-init/all-services.sql.
DETECTION_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
DETECTION_DATASOURCE_USERNAME=jarvis
DETECTION_DATASOURCE_PASSWORD=jarvis
DETECTION_JPA_HIBERNATE_DDL_AUTO=update
# `changed` stores and relays only frames that differ from the previous one for their source, plus
# each source's first frame. `all` keeps every pushed frame — see the README for the sizing this
# implies before switching.
DETECTION_RELAY_MODE=changed
# How far back a reconnecting client can catch up, and with it the ceiling on frame_events:
# retention x stored frame rate x frame size.
DETECTION_FRAME_RETENTION_SECONDS=300
DETECTION_RETENTION_SWEEP_SECONDS=30
# Frames a slow client may fall behind on the live stream before the hub drops its oldest. Small
# on purpose — a named subscription re-fetches dropped frames from the store on reconnect.
DETECTION_STREAM_QUEUE_DEPTH=8
# `async` writes frames behind the live stream, so a database stall cannot stall the video; a
# frame may then go out live and never be stored, costing only the ability to replay it.
# `sync` writes on the ingest thread, so anything broadcast is always replayable — at the price
# of putting Postgres back on the live path.
DETECTION_STORE_MODE=async
DETECTION_STORE_QUEUE_DEPTH=512

SERVER_ENGINE=spring
