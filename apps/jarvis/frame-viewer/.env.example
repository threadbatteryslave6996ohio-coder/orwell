# Jarvis frame viewer — a page over the frames the hub has already stored, plus video backfill.
#
# It reads frame_events directly and never joins the hub's stream: "what did this camera look like a
# minute ago" is a question about history. Writing goes the other way — an uploaded video is pushed
# to the hub as frames, because the hub is the only thing in the repo that ingests them.
#
# 127.0.0.1 on purpose. Set FRAME_VIEWER_AUTH_BASE_URL below and a sign-in is required; leave it
# blank and anything that can reach this port can watch every stored frame, and with uploads on, add
# frames of its own dated whenever it likes. The bind address is the backstop either way.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9003

# The same database the hub writes and jarvis-retention-worker trims. REQUIRED — a viewer that cannot
# read the table has nothing to show, and says so at startup rather than 503-ing every request.
# Role and database come from db-init/all-services.sql.
FRAME_VIEWER_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
FRAME_VIEWER_DATASOURCE_USERNAME=jarvis
FRAME_VIEWER_DATASOURCE_PASSWORD=jarvis

# Frames per page of the frame *list*, which carries no image bytes — so this bounds a JSON response
# of a few hundred bytes per frame, not the hub's tens of kilobytes. It is the ceiling as well as the
# default: a larger ?limit= is a 400, not a clamp.
FRAME_VIEWER_PAGE_SIZE=200

# --- Video backfill: POST /api/uploads ---------------------------------------------------------
# Where the hub is. Blank turns uploading off, and the route then answers 503 saying so — browsing
# needs only the database, so a viewer with no hub is still a perfectly good viewer.
FRAME_VIEWER_HUB_URL=http://127.0.0.1:9001
# The largest video accepted. Streamed to a temp file, never held in memory, so this bounds disk and
# the time a caller waits. 512 MiB is roughly an hour of 1080p screen capture.
FRAME_VIEWER_UPLOAD_MAX_BYTES=536870912
# Frames taken per second of video when the caller does not say. Low on purpose: frame_events holds
# the bytes and jarvis-retention-worker caps it at 2 GiB, so a generous default here would have one
# upload evict the live cameras' history. 600 frames is a ten-minute clip at this rate.
FRAME_VIEWER_UPLOAD_FPS=1.0
# How fast frames are pushed to the hub. The hub stores frames behind its live stream through a
# 512-deep queue (HUB_STORE_QUEUE_DEPTH): overrun it and a frame is delivered live and never stored,
# which for a backfill means it does not exist. Raise this with HUB_STORE_MODE=sync, not without.
FRAME_VIEWER_UPLOAD_PUSHES_PER_SECOND=25
# The ffmpeg to cut videos with. A bare name is resolved on PATH; a path is used as given.
FRAME_VIEWER_FFMPEG=ffmpeg

# --- Who may watch -----------------------------------------------------------------------------
# The auth server that decides. Blank leaves every route open — the local-development case, said
# loudly at startup and shown as a banner in the page. The compose service sets it, so a deployed
# stack is guarded by default.
#
# WHICH server this points at IS the access-control decision: whoever it accepts can watch every
# recording and upload more. The stack points it at admin-auth-server, not at the client-facing
# auth-server that mints identities for cameras and upload clients.
FRAME_VIEWER_AUTH_BASE_URL=
# The workspace within that server. Blank means "def".
FRAME_VIEWER_AUTH_WORKSPACE=
# How long a token that checked out stays accepted without asking the auth server again. One step
# through the history is three requests (the frame, plus the two neighbouring images it prefetches),
# so an uncached check makes holding an arrow key down a burst of blocking POSTs to auth. The cost is
# stated plainly: a revoked token keeps working here for up to this long. 0 checks every time.
FRAME_VIEWER_AUTH_CACHE_SECONDS=30
# `Secure` on the session cookie. Off by default because the default deployment is http://127.0.0.1
# and a Secure cookie is never sent over that. Turn it on anywhere this is reached over TLS.
FRAME_VIEWER_SECURE_COOKIES=false

# LOGGER picks the sinks: console, disk, loki, loki-with-fallback, both (see the root .env.example).
LOGGER=
