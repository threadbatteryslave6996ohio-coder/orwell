<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.orwell</groupId>
        <artifactId>orwell</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>dev.orwell</groupId>
    <artifactId>jarvis</artifactId>
    <packaging>pom</packaging>

    <!--
      Libraries first, then the three deployables. The split is by what each one costs to run, not
      by what it is about: the hub owns Postgres and the frame bytes, person detection burns CPU
      decoding images and talks to apps/alerting, and the retention worker holds no port at all.
      They used to be one process, which meant sizing one container for the most expensive.

      Only the hub takes frames over HTTP. Everything else that wants frames *watches* the hub
      through jarvis-frame-client, so a producer pushes each frame exactly once and the fan-out is
      the hub's job. That is why person-detection has no ingest endpoint of its own.
    -->
    <modules>
        <module>frame-core</module>
        <module>frame-client</module>
        <module>retention</module>
        <module>hub</module>
        <module>person-detection</module>
        <module>retention-worker</module>
    </modules>

</project>
