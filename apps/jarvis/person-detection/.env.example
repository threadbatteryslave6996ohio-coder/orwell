# Jarvis person detection — watches the hub's frame stream and alerts on people.
#
# It has no ingest endpoint. Producers push each frame once, to the hub; this subscribes and gets
# every frame that arrives. The port below serves GET /health only.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9002

# Where the hub is. Required — a detector that cannot reach the stream has nothing to do, and
# says so at startup rather than sitting idle looking healthy.
PERSON_DETECTION_HUB_URL=http://127.0.0.1:9001
# The durable cursor name the hub remembers this watcher's position under. A restart resumes where
# it stopped; change this and it starts from the head, skipping whatever arrived in between.
PERSON_DETECTION_SUBSCRIPTION=person-detection
# Watch one camera, or leave blank for every source.
PERSON_DETECTION_SOURCE=

# Where a detection alert is POSTed. Delivery is apps/alerting's job, not this service's.
PERSON_DETECTION_ALERT_URL=http://127.0.0.1:9000/alerts
# Repeat alerts for the same source are suppressed inside this window. Detection is asynchronous
# now, so this is the only thing between a person standing still and one alert per frame.
PERSON_DETECTION_ALERT_COOLDOWN_SECONDS=60
PERSON_DETECTION_MIN_CONFIDENCE=0.35

# No datasource and no SERVER_ENGINE: this service holds an in-memory cooldown per source, and
# has no request routes to serve on a second engine.
