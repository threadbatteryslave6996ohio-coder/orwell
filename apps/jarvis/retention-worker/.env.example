# Jarvis retention worker — bounds frame_events. No port: this process serves nothing.

# The same jarvis database the hub writes frames to.
RETENTION_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
RETENTION_DATASOURCE_USERNAME=jarvis
RETENTION_DATASOURCE_PASSWORD=jarvis

# frame_events is bounded by whichever of these bites first. The byte budget holds the footprint
# constant and lets the replay window vary with how busy the stream is — it is what protects the
# disk, on a Postgres shared with every other app. The age bound stops a quiet camera's frames
# living forever. Set either to 0 to disable that bound. Counts frame bytes, not on-disk size:
# indexes and not-yet-vacuumed rows cost extra, so leave headroom.
RETENTION_FRAME_MAX_BYTES=2147483648
RETENTION_FRAME_MAX_AGE_SECONDS=300
RETENTION_SWEEP_SECONDS=30

# There is no /health to read the sweep result from. It goes to the log — set LOKI_URL to have it
# shipped, and alert on "Frame retention sweep failed".
