# Jarvis frame hub — POST /frames in, GET /frames/stream out.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9001

# Frames are stored so a client that reconnects can be replayed what it missed, so the datasource
# is REQUIRED. Role and database come from db-init/all-services.sql.
HUB_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
HUB_DATASOURCE_USERNAME=jarvis
HUB_DATASOURCE_PASSWORD=jarvis
HUB_JPA_HIBERNATE_DDL_AUTO=update

# Frames a slow client may fall behind on the live stream before the hub drops its oldest. Small
# on purpose — a named subscription re-fetches dropped frames from the store on reconnect.
HUB_STREAM_QUEUE_DEPTH=8

# `async` writes frames behind the live stream, so a database stall cannot stall the video; a
# frame may then go out live and never be stored, costing only the ability to replay it.
# `sync` writes on the ingest thread, so anything broadcast is always replayable — at the price
# of putting Postgres back on the live path.
HUB_STORE_MODE=async
HUB_STORE_QUEUE_DEPTH=512

# No SERVER_ENGINE: the hub serves SSE, which is Spring-only.
# How large frame_events may get is NOT set here — it belongs to jarvis-retention-worker.
