# Apify API token from https://console.apify.com/settings/integrations — the only required value.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com
# Answers "how many followers?" in one dataset item. Input: {"usernames":["<handle>"]}.
APIFY_PROFILE_ACTOR=apify/instagram-profile-scraper
# Returns the actual follower/following accounts, billed per account returned.
# Input: {"Account":["<handle>"],"dataToScrape":"Followers|Following","resultsLimit":<n>}.
APIFY_CONNECTIONS_ACTOR=scraping_solutions/instagram-scraper-followers-following-no-cookies
# Budget for one actor run. A run that outlives it is aborted, so it cannot keep billing.
APIFY_RUN_TIMEOUT_SECONDS=120
# Accounts per lookup when --limit is not given.
INSTA_DEFAULT_LIMIT=100
# A spend guard, not a page size: every account returned is billed by the actor.
INSTA_MAX_LIMIT=500
# Caching. Every miss runs a paid actor, so this is a cost control before it is a latency one.
INSTA_CACHE_ENABLED=true
# 0 = entries never expire. Re-fetching costs credit against a daily quota, which
# currently bites harder than a stale follower list does.
INSTA_CACHE_TTL_HOURS=0
# The one Redis in the stack (docker-compose.all-services.yml). Keys are namespaced `insta:`,
# alongside keeboarder-server's `ws:` — see the README for why not a separate Redis database.
REDIS_HOST=localhost
REDIS_PORT=6379
# Logging sinks. Unset means the human-readable console (on stderr) and nothing else, which is the
# ordinary case for a program you run by hand. Set either of the two below to ship records instead.
INSTA_LOG_CONSOLE=true
# Same keys as the Spring services, so a deployment configures this app like any other.
LOKI_URL=
LOKI_TENANT_ID=
LOGGING_FILE_NAME=
# --- `insta sync` only: the follow graph -------------------------------------------------------
# Postgres. Unset means `sync` refuses to run; the lookup commands do not need it.
INSTA_DATABASE_URL=
INSTA_DATABASE_USERNAME=
INSTA_DATABASE_PASSWORD=
# Profile pictures: none | filesystem | http. Off by default — downloading copies of people's
# photographs should be deliberate, and with it off no image is even fetched.
INSTA_PICTURE_STORE=none
INSTA_PICTURE_DIR=
INSTA_BUCKET_URL=
INSTA_BUCKET_TOKEN=
# A fuse. A walk that would retire more than this share of an account's followers refuses to,
# because a private or deleted account returns an empty list that looks exactly like a mass exodus.
INSTA_MAX_RETIRE_PERCENT=20
# The viewer. Binds every interface by default and has no authentication — set 127.0.0.1 to keep
# it on this machine.
INSTA_UI_ADDRESS=0.0.0.0
INSTA_UI_PORT=5554
