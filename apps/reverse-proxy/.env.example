# Reverse proxy configuration
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9300
PROXY_UPSTREAM_URL=http://127.0.0.1:8080
# Comma-separated regexes, full-matched against /path?query, optionally scoped with METHOD:
PROXY_BLOCKED_PATTERNS=/admin.*,POST:/internal/.*
PROXY_UPSTREAM_TIMEOUT_SECONDS=30
PROXY_MAX_BODY_BYTES=10485760
