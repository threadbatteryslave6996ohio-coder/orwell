# Reverse proxy configuration
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9300
PROXY_UPSTREAM_URL=http://127.0.0.1:8080
# Comma-separated regexes, full-matched against /path?query, optionally scoped with METHOD:
PROXY_BLOCKED_PATTERNS=/admin.*,POST:/internal/.*
PROXY_UPSTREAM_TIMEOUT_SECONDS=30
PROXY_MAX_BODY_BYTES=10485760

# The audit trail's database. Left unset on purpose: unset means every request is still logged,
# but no request_audit row is written, which is what lets the jar run without a Postgres. Set
# these (the compose service does) to get the queryable table. An unreachable database here fails
# the startup rather than being discovered later as an empty table.
# PROXY_AUDIT_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/proxy
# PROXY_AUDIT_DATASOURCE_USERNAME=proxy
# PROXY_AUDIT_DATASOURCE_PASSWORD=proxy
# Records buffered ahead of the writer; a full queue drops rows rather than delaying a request.
PROXY_AUDIT_QUEUE_DEPTH=10000
# Days of trail kept, swept hourly. 0 keeps everything, on a Postgres the whole repo shares.
PROXY_AUDIT_RETENTION_DAYS=30
