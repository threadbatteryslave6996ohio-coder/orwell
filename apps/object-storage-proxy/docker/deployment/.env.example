# Image and listener
OBJECT_STORAGE_IMAGE_TAG=local
JARVIS_HTTP_PORT=5000
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=5000
JARVIS_SERVER_ROUTE_PREFIX=/jarvis
OBJECT_STORAGE_SERVER_URL=http://localhost:5000/jarvis

# Storage provider: aws or azure
OBJECT_STORAGE_PROVIDER=aws
OBJECT_STORAGE_MAX_FILE_SIZE=5368709120

# S3 configuration
OBJECT_STORAGE_S3_BUCKET_NAME=replace-me
OBJECT_STORAGE_S3_REGION=us-east-1
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_PATH_STYLE_ACCESS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure configuration (used when OBJECT_STORAGE_PROVIDER=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# External auth servers. AUTH_BASE_URL holds the upload clients; the second one holds the
# identities allowed into /admin, and must not be the same deployment.
AUTH_BASE_URL=http://host.docker.internal:8081
AUTH_IDENTITY_PROVISIONING_KEY=
OBJECT_STORAGE_ADMIN_AUTH_BASE_URL=http://host.docker.internal:8082
OBJECT_STORAGE_CORS_ALLOWED_ORIGINS=
