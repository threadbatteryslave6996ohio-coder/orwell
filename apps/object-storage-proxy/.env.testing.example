# Object storage proxy — testing environment
# Copy to .env.testing and adjust as needed.

OBJECT_STORAGE_IMAGE_TAG=local
OBJECT_STORAGE_HOST_PORT=5000
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=5000
OBJECT_STORAGE_SERVER_URL=http://localhost:5000

OBJECT_STORAGE_PROVIDER=aws
OBJECT_STORAGE_MAX_FILE_SIZE=5368709120

OBJECT_STORAGE_S3_BUCKET_NAME=test-bucket
OBJECT_STORAGE_S3_REGION=us-east-1
OBJECT_STORAGE_S3_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_S3_PATH_STYLE_ACCESS=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

AUTH_BASE_URL=http://host.docker.internal:8081
AUTH_IDENTITY_PROVISIONING_KEY=test-key
OBJECT_STORAGE_ADMIN_AUTH_BASE_URL=http://localhost:8082
OBJECT_STORAGE_CORS_ALLOWED_ORIGINS=*
