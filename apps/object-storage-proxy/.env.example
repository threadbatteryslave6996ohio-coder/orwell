# Object storage proxy configuration
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=5000

# Storage provider: aws or azure
OBJECT_STORAGE_PROVIDER=aws
OBJECT_STORAGE_MAX_FILE_SIZE=5368709120

# S3 settings
OBJECT_STORAGE_S3_BUCKET_NAME=your-bucket-name
OBJECT_STORAGE_S3_REGION=us-east-1
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_PATH_STYLE_ACCESS=false

# Azure settings
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONNECTION_STRING=

# Auth server
AUTH_BASE_URL=http://localhost:8081
AUTH_IDENTITY_PROVISIONING_KEY=

# Management dashboard (/admin). Required: the panel authenticates against this second auth
# deployment, which holds admin identities. Never point it at AUTH_BASE_URL above - that would
# let any upload client sign in and mint more upload clients.
OBJECT_STORAGE_ADMIN_AUTH_BASE_URL=http://localhost:8082

# CORS
OBJECT_STORAGE_CORS_ALLOWED_ORIGINS=

# Logging
OBJECT_STORAGE_LOGGING_AUDIT_FILE=logs/audit.log

# Server URL (used for secure cookie detection)
OBJECT_STORAGE_SERVER_URL=

# Stream analysis worker (AnalysisWorker). Endpoint the sampled JPEG frames are
# POSTed to; leave blank to sample frames without forwarding them.
STREAM_ANALYSIS_ENDPOINT=
