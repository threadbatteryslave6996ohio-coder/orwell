# Health monitor — polls other services' /health endpoints and says when one stops answering.
#
# It complements the compose health checks rather than replacing them: those restart a container and
# tell nobody, this tells somebody and gives one place to see the whole stack. It is also distinct
# from apps/liveness-analyzer, which is a dead-man's switch over heartbeat log lines from desktop
# CLIENTS — this actively probes SERVERS. Neither covers the other's case.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9005

# What to check: a comma-separated `name=url` list. The name is what appears in the alert, so use the
# service's name and not its address — "172.20.0.7 is down" at 3am is a puzzle, not a message.
#
# NOTE /health sits at the ROOT of each service, never under its route prefix: auth-server has
# AUTH_ROUTE_PREFIX=/auth and its health endpoint is still /health. nginx/all-services.conf is the
# authoritative list of where each one lives.
#
# Blank checks nothing, which is said loudly at startup.
HEALTH_MONITOR_TARGETS=

# Seconds between rounds, and the per-request timeout. The timeout MUST stay below the interval, or a
# dead target is still being waited on when the next round is due — it warns at startup if it is not.
# An outage is noticed within roughly interval x HEALTH_MONITOR_FAILURES_BEFORE_DOWN.
HEALTH_MONITOR_INTERVAL_SECONDS=30
HEALTH_MONITOR_TIMEOUT_SECONDS=5

# Consecutive results before the state flips. Two to go down, one to come back: one refused connection
# is a restart or a GC pause rather than an outage, and a monitor that pages on those gets muted —
# while believing good news quickly costs at most one extra alert if a service is flapping.
HEALTH_MONITOR_FAILURES_BEFORE_DOWN=2
HEALTH_MONITOR_SUCCESSES_BEFORE_UP=1

# Where a transition is POSTed, e.g. http://alerting/alerts. Blank logs only. Both directions are
# reported: a monitor that only tells you about failure leaves you with no way to know it is over.
HEALTH_MONITOR_ALERT_URL=

# THE HEARTBEAT NEEDS LOKI. With LOKI_URL set (it comes from the root .env in the compose stack) this
# app also publishes one line per completed round to a SEPARATE Loki stream, stream_type="heartbeat",
# so that something else can alert on its absence — apps/liveness-analyzer does exactly that with a
# config change and no code; see this app's README. Without LOKI_URL there is no heartbeat, nothing can
# detect this monitor dying, and it says so at startup.
#
# LOGGER picks the sinks: console, disk, loki, loki-with-fallback, both (see the root .env.example).
# loki-with-fallback earns its place here more than almost anywhere: this app's entire output is a
# handful of lines a year, each saying something broke, and a Loki outage that swallowed one would
# swallow the only record of an outage.
LOGGER=
