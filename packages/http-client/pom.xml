<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.orwell</groupId>
        <artifactId>orwell</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>http-client</artifactId>

    <!--
      The JDK plus this repo's own logger, and nothing else. Desktop clients depend on this as
      readily as servers do, so it must not drag in Spring — and `logger` does not: it is the same
      hand-written interface those clients already build a ConsoleLogger from in main.
    -->
    <dependencies>
        <dependency>
            <groupId>dev.orwell</groupId>
            <artifactId>logger</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JsonStubServer, for the tests that stand a real HTTP server up on a loopback port. -->
        <dependency>
            <groupId>dev.orwell</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
