    <artifactId>test-support</artifactId>

    <!--
      No dependencies at all, and that is the point. Its consumers include desktop clients whose
      test classpath is junit and nothing else; anything declared here would land on all of them.
      `server-test-support` is the other half of this — Spring contexts and Testcontainers — and a
      module takes whichever one it actually needs.
    -->
